{
  "name": "scan",
  "displayName": "SCAN Diagram Preview",
  "description": "Read-only preview for System & Component Architecture Notation (*.scan.yaml / *.scan) - pan, zoom, and inspect details.",
  "version": "0.1.8",
  "publisher": "spherescan",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "scan",
    "architecture",
    "diagram",
    "yaml",
    "spherescan"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/w2b-hq-app-cloud/scan-js.git",
    "directory": "packages/vscode-scan"
  },
  "homepage": "https://github.com/w2b-hq-app-cloud/scan-js/tree/main/packages/vscode-scan",
  "bugs": {
    "url": "https://github.com/w2b-hq-app-cloud/scan-js/issues"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:scan",
    "onLanguage:yaml",
    "onCustomEditor:scan.previewEditor",
    "onCommand:scan.openPreview",
    "onCommand:scan.openPreviewToSide",
    "onCommand:scan.showSource",
    "onCommand:scan.refreshPreview"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scan",
        "aliases": [
          "SCAN",
          "scan"
        ],
        "extensions": [
          ".scan"
        ],
        "filenamePatterns": [
          "*.scan.yaml",
          "*.scan.yml",
          "*.scan"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/scan.svg",
          "dark": "./icons/scan-dark.svg"
        }
      }
    ],
    "customEditors": [
      {
        "viewType": "scan.previewEditor",
        "displayName": "SCAN Preview",
        "selector": [
          {
            "filenamePattern": "*.scan.yaml"
          },
          {
            "filenamePattern": "*.scan.yml"
          },
          {
            "filenamePattern": "*.scan"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "scan.openPreview",
        "title": "Open Preview",
        "category": "SCAN",
        "icon": "$(open-preview)"
      },
      {
        "command": "scan.openPreviewToSide",
        "title": "Open Preview to the Side",
        "category": "SCAN",
        "icon": "$(open-preview)"
      },
      {
        "command": "scan.showSource",
        "title": "Show Source",
        "category": "SCAN",
        "icon": "$(go-to-file)"
      },
      {
        "command": "scan.refreshPreview",
        "title": "Refresh Preview",
        "category": "SCAN",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "scan.isScanEditor && !scan.isPreviewEditor",
          "command": "scan.openPreview",
          "group": "navigation@1"
        },
        {
          "when": "scan.isPreviewEditor",
          "command": "scan.showSource",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "when": "scan.isScanEditor",
          "command": "scan.openPreviewToSide",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "scan.isScanEditor && !scan.isPreviewEditor",
          "command": "scan.openPreview",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == scan",
          "command": "scan.openPreview",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "scan.openPreview",
          "when": "scan.isScanEditor || scan.isPreviewEditor"
        },
        {
          "command": "scan.openPreviewToSide",
          "when": "scan.isScanEditor"
        },
        {
          "command": "scan.showSource",
          "when": "scan.isPreviewEditor"
        },
        {
          "command": "scan.refreshPreview",
          "when": "scan.isScanEditor || scan.isPreviewEditor"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scan.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "scan.isScanEditor && !scan.isPreviewEditor"
      },
      {
        "command": "scan.showSource",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "scan.isPreviewEditor"
      },
      {
        "command": "scan.openPreviewToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "scan.isScanEditor && !scan.isPreviewEditor"
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.scan.yaml": "scan",
        "*.scan.yml": "scan",
        "*.scan": "scan"
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "dependencies": {
    "@spherescan/model": "0.4.0",
    "@spherescan/viewer": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.3"
  }
}
